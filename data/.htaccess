# Deny all direct access to the raw JSON data files.
# Works on Apache 2.4+ ("Require all denied") and falls back to the
# 2.2-style directive for older hosts. data/index.php below is a second
# layer of defense for servers that ignore .htaccess entirely.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
